local typeOf = (type(typeof) == "function") and typeof or type

-- Forward declaration: the staff watcher notifies through it, and the library
-- is loaded further down. A local declared at that point would not be in scope
-- inside the watcher's closures.
local Nexa

-- One clock for the whole script; tick() exists in every executor seen here.
local clock = tick or os.clock

-- running it twice should replace the old boxes, not stack another set on top.
-- Some executors give every execution a fresh _G, so getgenv() is checked too -
-- that is where a re-run can actually find the previous instance.
local function findPrev()
    local list = { rawget(_G, "FUST_ESP") }
    if type(getgenv) == "function" then
        local env = getgenv()
        if type(env) == "table" then list[#list + 1] = env.FUST_ESP end
    end
    for i = 1, #list do
        local v = list[i]
        if type(v) == "table" and type(v.unload) == "function" then return v end
    end
    return nil
end

local prev = findPrev()
if prev then pcall(prev.unload) end

